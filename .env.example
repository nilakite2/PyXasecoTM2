# Use the login and password from <authorization_levels> in the dedicated config.
# Leave the RPC password empty to be prompted.
PYXASECOMP_RPC_LOGIN=SuperAdmin
PYXASECOMP_RPC_PASSWORD=

# Optional TM2 Dedimania code (not the dedicated or TMF password).
# Enables lookups and eligible replay-backed record submissions at map end.
PYXASECOMP_DEDI_CODE=
# Optional absolute path to this dedicated server's UserData/Replays directory.
# Only needed if GameDataDirectory cannot be resolved locally (new #1 ghost uploads).
PYXASECOMP_REPLAYS_DIR=

# Optional WRMania overrides. Blank uses dedicated_cfg.default.txt and the server zone.
# Set a path only if the dedicated uses a differently named config or layout.
PYXASECOMP_WRMANIA_DEDICATED_CFG=
PYXASECOMP_WRMANIA_SERVER_LOGIN=
# Use the dedicated account password, not the XML-RPC password or Dedimania code.
PYXASECOMP_WRMANIA_SERVER_PASSWORD=
PYXASECOMP_WRMANIA_NATION=

# Optional MXKarma key issued for this dedicated server at https://karma.mania-exchange.com/.
# Setting it enables global ratings and submission of new votes. Leave blank for local only.
PYXASECOMP_MX_KARMA_KEY=

# PYXA Stats website origin (HTTPS, without /api).
# MP reports use mp4-<server-login>; join links use the real login and active title.
# Leave the base blank to disable publishing. No dedicated/masterserver password here.
PYXASECOMP_STATS_API_BASE=https://tmtrialgy.com
# Optional: match PUBLIC_STATS_WRITE_TOKEN only if the website has one configured.
PYXASECOMP_STATS_API_TOKEN=

# Trial and RPG use the same providers as TMF. Tokens stay optional.
TRIAL_API_BASE=https://tmtrialgy.com
TRIAL_API_TOKEN=
RPG_API_BASE=https://www.tmrpg.com
RPG_API_TOKEN=

# Use a separate database and grant the MP account access only to that database.
MP_DB_HOST=127.0.0.1
MP_DB_PORT=3306
MP_DB_NAME=
MP_DB_USER=
MP_DB_PASSWORD=
